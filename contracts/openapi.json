        "required": [
          "documentId",
          "from",
          "to",
          "currentVersion",
          "titleChanged",
          "contentChanged",
          "lineEndingsOnly",
          "simplified",
          "addedLines",
          "removedLines",
          "totalRows",
          "offset",
          "lines",
          "nextOffset"
