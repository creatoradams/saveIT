        "required": [
          "id",
          "organizationId",
          "assetId",
          "title",
          "content",
          "version",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
