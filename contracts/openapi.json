        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "$ref": "#/components/schemas/RevisionSummaryDto"
          },
          "to": {
            "$ref": "#/components/schemas/RevisionSummaryDto"
          },
          "currentVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "titleChanged": {
            "type": "boolean"
          },
          "contentChanged": {
            "type": "boolean"
