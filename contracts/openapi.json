            "format": "int32"
          },
          "newLine": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "text": {
            "type": "string"
          }
        }
      },
