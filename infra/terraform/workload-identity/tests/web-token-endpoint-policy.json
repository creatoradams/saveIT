    {"Sid":"RejectOtherPools","Effect":"Deny","Principal":"*","Action":"*","NotResource":"arn:aws:cognito-identity:us-east-1:111122223333:identitypool/us-east-1:10000000-0000-0000-0000-000000000001"},
