# Synthetic LOCAL development values only. Copying is optional for npm run dev.
SAVEIT_DB_PORT=55432
SAVEIT_API_PORT=5080
SAVEIT_WEB_PORT=3000
# Never put production credentials in this repository.

# Optional enterprise setup template; empty placeholders contain no credentials.
# The local launcher always uses synthetic development identity. See docs/adr/010-okta-identity.md.
# Supply actual values through protected deployment configuration, not a tracked file.
Identity__Okta__Enabled=false
Identity__Okta__Issuer=
Identity__Okta__ClientId=
Identity__Okta__ClientSecret=
Identity__Okta__TenantId=
Identity__Okta__PublicOrigin=
Identity__Okta__RequiredAcr=
Identity__KeyDirectory=
Identity__KeyCertificatePath=
# Choose exactly one Path or Base64 source; inject actual values through a secret manager.
Identity__KeyCertificateBase64=
Identity__KeyCertificatePassword=
SAVEIT_OKTA_ISSUER=
# Optional Linux API TLS mode; separate transport key, never the session protector.
# Supply exactly one protected PFX source when enabled. See docs/deployment.md.
# Deployment__ApiTls__Enabled=true
# Deployment__ApiTls__CertificatePath=
# Deployment__ApiTls__CertificateBase64=
# Deployment__ApiTls__CertificatePassword=
# Production web requires HTTPS; private CA trust is public data read at Node startup.
# SAVEIT_API_ORIGIN=https://api.example.invalid:8443
# NODE_EXTRA_CA_CERTS=/opt/saveit/trust/api-ca.crt
# Optional public release hashes; declared cloud tasks require both.
# SAVEIT_API_CA_SHA256=
# Deployment__Trust__DatabaseCaSha256=
# Public CA bytes come from reviewed named image inputs, never these values or Terraform.
# Optional API-side mutual TLS. Public metadata only; client key delivery remains separate.
# Deployment__ApiTls__ClientAuthentication__Enabled=true
# Deployment__ApiTls__ClientAuthentication__CaSha256=
# Deployment__ApiTls__ClientAuthentication__LeafSha256__0=
# Supply 1-4 contiguous distinct lowercase SHA256 leaf pins and a separate public client CA image context.
